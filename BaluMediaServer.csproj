<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>
		<UseMaui>true</UseMaui>
		<SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- NuGet Package Properties -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>BaluMediaServer.CameraStreamer</PackageId>
		<PackageVersion>1.5.16</PackageVersion>
		<Authors>Nakano Miku 13</Authors>
		<Company>Balu Media Server</Company>
		<Product>Balu Media Camera Streamer</Product>
		<Description>Android camera streaming library with dual camera support for MAUI applications</Description>
		<Copyright>Copyright © Balu Media Server 2025</Copyright>
		<PackageTags>android;camera;streaming;maui;dual-camera;rtsp;h264;mjpeg;rtp;rtcp;video;aac;h265;RTSP;rtsp</PackageTags>
		<PackageProjectUrl>https://github.com/BaluMediaServer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BaluMediaServer/BaluMediaServer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>v1.5.16: H.264 Stream Freeze Fix — Fixed critical MediaTek encoder stall caused by SetFloat(KeyIFrameInterval) being misinterpreted as 0 (all-IDR output); replaced with SetInteger. Fixed RTP timestamps 1000x too fast due to MediaCodec PresentationTimeUs units varying across SoCs; now uses Stopwatch wall-clock time for cross-device reliability. Hardened client lifecycle with graduated error counting (10 TCP / 5 UDP threshold), IsPlaying-first dead client checks, safe cleanup ordering to prevent ObjectDisposedException, and 2-second frame dequeue timeout to prevent blocking on encoder stalls. Fixed FramePacer inverted drop logic (now correctly drops burst frames, not post-stall frames). Encoding loop reordered to drain output before feeding input, reducing frame loss on resource-constrained SoCs.</PackageReleaseNotes>
		
		<!-- Include symbols for debugging -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		
		<!-- Include dependencies -->
		<DevelopmentDependency>false</DevelopmentDependency>
	</PropertyGroup>


	<!-- Exclude test project folder from compilation -->
	<ItemGroup>
		<Compile Remove="BaluMediaServer.Tests\**" />
		<None Remove="BaluMediaServer.Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.51" />
		<!-- Pin to match the version resolved by Microsoft.Maui.Controls, silencing NU1608 -->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.1" />
	</ItemGroup>
	<ItemGroup>
		<AndroidLibrary Include="Jar\camerastreamer-release.aar" />
	</ItemGroup>

	<ItemGroup>
		<TransformFile Include="Transforms\Metadata.xml" />
	</ItemGroup>
</Project>
