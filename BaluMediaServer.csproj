<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>
		<UseMaui>true</UseMaui>
		<SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- NuGet Package Properties -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>BaluMediaServer.CameraStreamer</PackageId>
		<PackageVersion>1.5.28</PackageVersion>
		<Authors>Nakano Miku 13</Authors>
		<Company>Balu Media Server</Company>
		<Product>Balu Media Camera Streamer</Product>
		<Description>Android camera streaming library with dual camera support and optional AAC audio for MAUI applications</Description>
		<Copyright>Copyright © Balu Media Server 2025</Copyright>
		<PackageTags>android;camera;streaming;maui;dual-camera;rtsp;h264;mjpeg;rtp;rtcp;video;aac;audio;h265;RTSP;rtsp</PackageTags>
		<PackageProjectUrl>https://github.com/BaluMediaServer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BaluMediaServer/BaluMediaServer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>v1.5.28: AAC Audio Streaming — Optional second m=audio RTSP track (trackID=1) carrying hardware-encoded AAC-LC alongside the existing H.264 video track. New ServerConfiguration flags: EnableAudioTrack (default false — fully backward compatible), AudioSampleRateHz (default 44100), AudioChannels (default 1). When enabled, SDP advertises mpeg4-generic/sampleRate/channels with RFC 3640 AAC-hbr fmtp parameters; SETUP for trackID=1 is honoured with its own SSRC, sequence number, and Audio* transport fields on Client (so video and audio share the RTSP session but have fully independent RTP streams). New components: AudioCaptureService (Android AudioRecord wrapper producing 1024-sample PCM-16 frames), AacEncoder (MediaCodec audio/mp4a-latm wrapper), AacEncoderManager (fan-out to per-client channels). New RtpPacketBuilder methods: BuildAacRtpPacket (one access unit per RFC 3640 packet, 4-byte AU-headers section) and EncoderTimestampToAudioRtp (audio-clock conversion). New ITransportManager.SendAudioBatchSync routes through Client.AudioRtpChannel / AudioRtpEndPoint / AudioUdpSocket while sharing the per-client SendLock with video to keep TCP-interleaved framing atomic. SdpGenerator.UpdateAudioSpecificConfig syncs the fmtp config= parameter to the actual AudioSpecificConfig the hardware codec reports. Server lifecycle: audio pipeline is started on first audio-track SETUP and torn down by WatchDog when ClientCount==0, mirroring the H.264 idle-stall policy. Verified with VLC and ffplay multi-track SDP parsing on net9.0-android.</PackageReleaseNotes>
		
		<!-- Include symbols for debugging -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		
		<!-- Include dependencies -->
		<DevelopmentDependency>false</DevelopmentDependency>
	</PropertyGroup>


	<!-- Exclude test project folder from compilation -->
	<ItemGroup>
		<Compile Remove="BaluMediaServer.Tests\**" />
		<None Remove="BaluMediaServer.Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.51" />
		<!-- Pin to match the version resolved by Microsoft.Maui.Controls, silencing NU1608 -->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.1" />
	</ItemGroup>
	<ItemGroup>
		<AndroidLibrary Include="Jar\camerastreamer-release.aar" />
	</ItemGroup>

	<ItemGroup>
		<TransformFile Include="Transforms\Metadata.xml" />
	</ItemGroup>

	<!-- Make BaluLogger available in every file without an explicit using statement -->
	<ItemGroup>
		<Using Include="BaluMediaServer" />
	</ItemGroup>
</Project>
