<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>
		<UseMaui>true</UseMaui>
		<SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- NuGet Package Properties -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>BaluMediaServer.CameraStreamer</PackageId>
		<PackageVersion>1.5.25</PackageVersion>
		<Authors>Nakano Miku 13</Authors>
		<Company>Balu Media Server</Company>
		<Product>Balu Media Camera Streamer</Product>
		<Description>Android camera streaming library with dual camera support for MAUI applications</Description>
		<Copyright>Copyright © Balu Media Server 2025</Copyright>
		<PackageTags>android;camera;streaming;maui;dual-camera;rtsp;h264;mjpeg;rtp;rtcp;video;aac;h265;RTSP;rtsp</PackageTags>
		<PackageProjectUrl>https://github.com/BaluMediaServer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BaluMediaServer/BaluMediaServer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>v1.5.25: Performance, Stability &amp; FrameOverlay — Added YUV-level text burn-in (FrameOverlay) via ServerConfiguration.BackCameraOverlaySlots / FrontCameraOverlaySlots; BT.601 limited-range color conversion, drop-shadow, configurable anchor, font size, color, and alpha; H.264 only, per-frame hot path ~2µs. Fixed simultaneous-connect race: replaced volatile bool _isStreaming with Interlocked.CompareExchange on int flag so CameraStartRequested and StreamingStateChanged(true) each fire exactly once regardless of concurrent SETUP requests. Replaced Thread.Sleep in FramePacer with SpinWait for sub-millisecond precision. Added per-CameraId Channel caching in EncoderManager to avoid repeated allocation on reconnect. Selective buffer zeroing: only pad bytes written to encoder input buffer rather than zeroing the full stride-aligned region. Narrowed fan-out lock in RtpPacketBuilder to cover only the client list snapshot, not the entire send loop. Removed unreachable dead-code paths in StreamingController. Build: replaced all CA1416 Build.VERSION guards with OperatingSystem.IsAndroidVersionAtLeast(); removed stale XML doc param tags (CS1572); fixed CS8603 null-forgiving on cached encoder field; removed unused dropped-frame counters (CS0169); pinned Xamarin.AndroidX.Collection.Ktx 1.5.0.1 to silence NU1608; rewrote Transforms/Metadata.xml removing ~30 stale rules that produced BG8A00 noise.</PackageReleaseNotes>
		
		<!-- Include symbols for debugging -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		
		<!-- Include dependencies -->
		<DevelopmentDependency>false</DevelopmentDependency>
	</PropertyGroup>


	<!-- Exclude test project folder from compilation -->
	<ItemGroup>
		<Compile Remove="BaluMediaServer.Tests\**" />
		<None Remove="BaluMediaServer.Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.51" />
		<!-- Pin to match the version resolved by Microsoft.Maui.Controls, silencing NU1608 -->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.1" />
	</ItemGroup>
	<ItemGroup>
		<AndroidLibrary Include="Jar\camerastreamer-release.aar" />
	</ItemGroup>

	<ItemGroup>
		<TransformFile Include="Transforms\Metadata.xml" />
	</ItemGroup>
</Project>
