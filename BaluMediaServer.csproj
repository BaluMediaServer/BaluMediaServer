<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>
		<UseMaui>true</UseMaui>
		<SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- NuGet Package Properties -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>BaluMediaServer.CameraStreamer</PackageId>
		<PackageVersion>1.5.25</PackageVersion>
		<Authors>Nakano Miku 13</Authors>
		<Company>Balu Media Server</Company>
		<Product>Balu Media Camera Streamer</Product>
		<Description>Android camera streaming library with dual camera support for MAUI applications</Description>
		<Copyright>Copyright © Balu Media Server 2025</Copyright>
		<PackageTags>android;camera;streaming;maui;dual-camera;rtsp;h264;mjpeg;rtp;rtcp;video;aac;h265;RTSP;rtsp</PackageTags>
		<PackageProjectUrl>https://github.com/BaluMediaServer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BaluMediaServer/BaluMediaServer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>v1.5.25: Performance, Stability, Server Restart Hardening &amp; In-Process Logging — Hot-path: persistent SpinWait escalation fix (was resetting each iteration, burning CPU); per-client Channel ref caching eliminates 50 dict-lock acquisitions/s/client; selective encoder buffer zeroing (zero Array.Clear on common path); fan-out lock narrowed to snapshot only; dead ConvertNV21ToNV12Pooled removed; ProbeSupportedResolution uses cached encoder. Simultaneous-connect race fix: volatile bool replaced with Interlocked.CompareExchange int flag so CameraStartRequested and StreamingStateChanged(true) each fire exactly once. Server restart hardening: Stop() now calls StopCapture() on both cameras (fixes hung camera2 session surviving watchdog restarts), ClearAllClients(), SetStreamingState(false), and resets _isCapturingBack/Front flags; OnStreaming fires only on real state transitions (was firing every 5s unconditionally); PreStartCameraAndEncoder guards SetStreamingState with if(!_isStreaming). In-process logging: BaluLogger static class wraps all 264+ Log.X() calls — writes to logcat AND fires BaluLogger.OnLog (BaluLogEventArgs with Level/Tag/Message/Timestamp) so apps receive full internal diagnostics without ADB. FrameOverlay: YUV-level text burn-in via ServerConfiguration.BackCameraOverlaySlots/FrontCameraOverlaySlots; BT.601, drop-shadow, configurable anchor/size/color; H.264 only; ~2µs/frame. Build: CA1416 guards replaced with OperatingSystem.IsAndroidVersionAtLeast(); CS8603/CS1572/CS0169 fixed; Xamarin.AndroidX.Collection.Ktx 1.5.0.1 pinned; Metadata.xml rewritten removing 30 stale BG8A00 rules.</PackageReleaseNotes>
		
		<!-- Include symbols for debugging -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		
		<!-- Include dependencies -->
		<DevelopmentDependency>false</DevelopmentDependency>
	</PropertyGroup>


	<!-- Exclude test project folder from compilation -->
	<ItemGroup>
		<Compile Remove="BaluMediaServer.Tests\**" />
		<None Remove="BaluMediaServer.Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.51" />
		<!-- Pin to match the version resolved by Microsoft.Maui.Controls, silencing NU1608 -->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.1" />
	</ItemGroup>
	<ItemGroup>
		<AndroidLibrary Include="Jar\camerastreamer-release.aar" />
	</ItemGroup>

	<ItemGroup>
		<TransformFile Include="Transforms\Metadata.xml" />
	</ItemGroup>

	<!-- Make BaluLogger available in every file without an explicit using statement -->
	<ItemGroup>
		<Using Include="BaluMediaServer" />
	</ItemGroup>
</Project>
